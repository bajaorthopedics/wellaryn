{
  "expo": {
    "name": "Wellaryn",
    "slug": "wellaryn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wellaryn",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellaryn.Wellaryn",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Wellaryn reads your health data to calculate your readiness score.",
        "NSHealthUpdateUsageDescription": "Wellaryn syncs your training data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.wellaryn.app",
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "supabaseUrl": "https://bahdtqwqwkyrpchftemh.supabase.co",
      "supabaseAnonKey": "your-anon-key",
      "eas": {
        "projectId": "0c92f42a-95d8-49eb-9aab-1df4a8fb4dd0"
      }
    },
    "owner": "jumarca"
  }
}
