{
  "expo": {
    "name": "Wellaryn",
    "slug": "wellaryn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wellaryn",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellaryn.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Wellaryn reads your health data to calculate your readiness score.",
        "NSHealthUpdateUsageDescription": "Wellaryn syncs your training data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.wellaryn.app",
      "permissions": ["ACTIVITY_RECOGNITION"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-haptics",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "supabaseUrl": "https://bahdtqwqwkyrpchftemh.supabase.co",
      "supabaseAnonKey": "your-anon-key"
    }
  }
}
